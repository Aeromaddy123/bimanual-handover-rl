<mujoco model="panda handover">
  <compiler angle="radian" autolimits="true"/>

  <option timestep="0.005" iterations="5" ls_iterations="8" integrator="implicitfast">
    <flag eulerdamp="disable"/>
  </option>

  <custom>
    <numeric data="12" name="max_contact_points"/>
  </custom>

  <statistic center="0 0 0.3" extent="1.5"/>

  <visual>
    <map fogstart="2.6" fogend="6.0"/>
    <rgba fog="0.035 0.038 0.043 1"/>
    <headlight diffuse=".35 .35 .35" ambient=".12 .12 .13" specular=".1 .1 .1"/>
    <global azimuth="150" elevation="-25" offwidth="1920" offheight="1920"/>
    <quality shadowsize="8192"/>
  </visual>

  <asset>
    <model name="panda" file="franka/mjx_panda.xml"/>
    <texture type="skybox" builtin="gradient" rgb1="0.035 0.038 0.043" rgb2="0.02 0.022 0.026" width="512" height="512"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.11 0.115 0.125" rgb2="0.10 0.105 0.115"
      markrgb="0.17 0.18 0.19" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="6 6" reflectance="0.12"/>
    <material name="bar" rgba="0.95 0.45 0.10 1" specular="0.3" shininess="0.4"/>
  </asset>

  <worldbody>
    <light name="key" pos="0.6 -0.8 2.2" dir="-0.3 0.4 -1" directional="true" diffuse="0.75 0.74 0.72" castshadow="true"/>
    <light name="rim" pos="-1.2 1.5 1.6" dir="0.5 -0.6 -0.5" directional="true" diffuse="0.35 0.38 0.45" castshadow="false"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" contype="1" conaffinity="1"/>

    <frame name="a_mount" pos="-0.7 0 0">
      <attach model="panda" body="link0" prefix="a_"/>
    </frame>
    <frame name="b_mount" pos="0.7 0 0" euler="0 0 3.14159265359">
      <attach model="panda" body="link0" prefix="b_"/>
    </frame>

    <body name="bar" pos="-0.28 0 0.02">
      <freejoint/>
      <geom name="bar" type="box" size="0.10 0.02 0.02" material="bar" mass="0.05" condim="4"
        friction="1 .05 .003" contype="2" conaffinity="1" solref="0.01 1"/>
      <site name="grip_a" pos="-0.065 0 0" size="0.005" rgba="0 0 0 0"/>
      <site name="grip_b" pos="0.065 0 0" size="0.005" rgba="0 0 0 0"/>
    </body>

    <body mocap="true" name="goal" pos="0.3 0 0.25">
      <geom type="box" size="0.10 0.02 0.02" rgba="0.2 0.6 0.3 0.25" contype="0" conaffinity="0"/>
    </body>
  </worldbody>

  <sensor>
    <contact name="a_lpad_bar" geom1="a_left_finger_pad" geom2="bar" reduce="mindist" num="1" data="found"/>
    <contact name="a_rpad_bar" geom1="a_right_finger_pad" geom2="bar" reduce="mindist" num="1" data="found"/>
    <contact name="b_lpad_bar" geom1="b_left_finger_pad" geom2="bar" reduce="mindist" num="1" data="found"/>
    <contact name="b_rpad_bar" geom1="b_right_finger_pad" geom2="bar" reduce="mindist" num="1" data="found"/>
    <contact name="a_hand_floor" geom1="a_hand_capsule" geom2="floor" reduce="mindist" num="1" data="found"/>
    <contact name="b_hand_floor" geom1="b_hand_capsule" geom2="floor" reduce="mindist" num="1" data="found"/>
  </sensor>

  <keyframe>
    <key name="home"
      qpos="0 -0.785 0 -2.356 0 1.571 0.785 0.04 0.04  0 -0.785 0 -2.356 0 1.571 0.785 0.04 0.04  -0.28 0 0.02 1 0 0 0"
      ctrl="0 -0.785 0 -2.356 0 1.571 0.785 0.04  0 -0.785 0 -2.356 0 1.571 0.785 0.04"/>
  </keyframe>
</mujoco>
